          "content": {
            "size": 8109,
            "mimeType": "application/javascript",
            "text": "/*\n * ═══════════════════════════════════════════════════════════════\n *  OUTLOOK READER — Advanced motion layer\n *  · Intro curtain (once per session)\n *  · Scroll reveal for long inbox results\n *  · Magnetic buttons\n *  · Custom mint cursor (dot + trailing glow ring)\n *  · Count-up for the Auto Format stats\n *\n *  Fully self-contained — no dependency on app.js internals. Everything\n *  respects prefers-reduced-motion, and pointer effects only run on\n *  devices with a real (fine) pointer.\n * ═══════════════════════════════════════════════════════════════\n */\n(function () {\n    'use strict';\n\n    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    const finePointer  = window.matchMedia('(pointer: fine)').matches;\n\n    const clamp = (v, max) => Math.max(-max, Math.min(max, v));\n\n    document.addEventListener('DOMContentLoaded', () => {\n        introCurtain();\n        scrollRevealInbox();\n        countUpStats();\n\n        if (finePointer && !reduceMotion) {\n            magneticButtons();\n        }\n    });\n\n    // ─── 1. Intro curtain ───────────────────────────────────────\n    function introCurtain() {\n        if (reduceMotion) return;\n        try { if (sessionStorage.getItem('introShown')) return; sessionStorage.setItem('introShown', '1'); } catch (e) {}\n\n        const curtain = document.createElement('div');\n        curtain.className = 'intro-curtain';\n        curtain.innerHTML = '<div class=\"intro-mark\">Outlook<span>Reader</span></div>';\n        document.body.appendChild(curtain);\n\n        // Hold briefly, then lift the curtain up to reveal the app.\n        setTimeout(() => curtain.classList.add('intro-exit'), 900);\n        curtain.addEventListener('animationend', (e) => {\n            if (e.animationName === 'curtainUp') curtain.remove();\n        });\n        // Safety net in case animationend never fires.\n        setTimeout(() => curtain.remove(), 2400);\n    }\n\n    // ─── 2. Scroll reveal for inbox results ─────────────────────\n    function scrollRevealInbox() {\n        const area = document.getElementById('resultsArea');\n        if (!area) return;\n\n        let io = null;\n        if (!reduceMotion && 'IntersectionObserver' in window) {\n            io = new IntersectionObserver((entries) => {\n                entries.forEach((en) => {\n                    if (en.isIntersecting) {\n                        en.target.classList.add('is-revealed');\n                        io.unobserve(en.target);\n                    }\n                });\n            }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });\n        }\n\n        const prep = (el) => {\n            el.style.animation = 'none'; // cancel app.js's immediate fade-in\n            if (reduceMotion || !io) { el.classList.add('is-revealed'); return; }\n            el.classList.add('reveal-on-scroll');\n            io.observe(el);\n        };\n\n        // Watch for account cards being appended (chunked rendering).\n        new MutationObserver((muts) => {\n            muts.forEach((m) => {\n                m.addedNodes.forEach((n) => {\n                    if (n.nodeType === 1 && n.classList.contains('account-result')) prep(n);\n                });\n            });\n        }).observe(area, { childList: true });\n    }\n\n    // ─── 3. Magnetic buttons ────────────────────────────────────\n    function magneticButtons() {\n        const wire = (el) => {\n            if (el._magnetic) return;\n            el._magnetic = true;\n            el.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1)';\n            el.addEventListener('mousemove', (e) => {\n                const r = el.getBoundingClientRect();\n                const x = e.clientX - (r.left + r.width / 2);\n                const y = e.clientY - (r.top + r.height / 2);\n                el.style.transform = `translate(${clamp(x * 0.3, 10)}px, ${clamp(y * 0.4, 8)}px)`;\n            });\n            el.addEventListener('mouseleave', () => { el.style.transform = ''; });\n        };\n\n        document.querySelectorAll('.btn, .contact-link').forEach(wire);\n\n        // Copy buttons inside inbox results are added dynamically.\n        const area = document.getElementById('resultsArea');\n        if (area) {\n            new MutationObserver((muts) => {\n                muts.forEach((m) => m.addedNodes.forEach((n) => {\n                    if (n.nodeType === 1 && n.querySelectorAll) n.querySelectorAll('.btn').forEach(wire);\n                }));\n            }).observe(area, { childList: true, subtree: true });\n        }\n    }\n\n    // ─── 4. Custom cursor ───────────────────────────────────────\n    function customCursor() {\n        const root = document.documentElement;\n        const dot  = document.createElement('div');\n        const ring = document.createElement('div');\n        dot.className  = 'cursor-dot';\n        ring.className = 'cursor-ring';\n        document.body.appendChild(ring);\n        document.body.appendChild(dot);\n        root.classList.add('has-cursor');\n\n        let mx = window.innerWidth / 2, my = window.innerHeight / 2;\n        let rx = mx, ry = my;\n\n        window.addEventListener('mousemove', (e) => {\n            mx = e.clientX; my = e.clientY;\n            dot.style.transform = `translate(${mx}px, ${my}px) translate(-50%, -50%)`;\n            root.classList.add('cursor-active');\n        }, { passive: true });\n\n        (function loop() {\n            rx += (mx - rx) * 0.18;\n            ry += (my - ry) * 0.18;\n            ring.style.transform = `translate(${rx}px, ${ry}px) translate(-50%, -50%)`;\n            requestAnimationFrame(loop);\n        })();\n\n        const interactive = 'a, button, .btn, .nav-link, input, textarea, select, summary, label, .role-chip, .copy-code-btn, .contact-link';\n        document.addEventListener('mouseover', (e) => {\n            if (e.target.closest && e.target.closest(interactive)) root.classList.add('cursor-hover');\n        });\n        document.addEventListener('mouseout', (e) => {\n            if (e.target.closest && e.target.closest(interactive)) root.classList.remove('cursor-hover');\n        });\n        document.addEventListener('mouseleave', () => root.classList.remove('cursor-active'));\n        document.addEventListener('mouseenter', () => root.classList.add('cursor-active'));\n    }\n\n    // ─── 5. Count-up for Auto Format stats ──────────────────────\n    function countUpStats() {\n        if (reduceMotion) return;\n        ['statTotal', 'statFiles', 'statDups'].forEach((id) => {\n            const el = document.getElementById(id);\n            if (el) countUp(el);\n        });\n    }\n\n    function countUp(el) {\n        let animating = false;\n        el._shown = parseInt(el.textContent, 10) || 0;\n\n        new MutationObserver(() => {\n            if (animating) return;\n            const target = parseInt((el.textContent || '').replace(/[^\\d-]/g, ''), 10);\n            if (isNaN(target) || target === el._shown) return;\n\n            animating = true;\n            const from = el._shown;\n            const dur = 650;\n            const t0 = performance.now();\n\n            (function tick(now) {\n                const p = Math.min((now - t0) / dur, 1);\n                const eased = 1 - Math.pow(1 - p, 3);\n                el.textContent = Math.round(from + (target - from) * eased);\n                if (p < 1) requestAnimationFrame(tick);\n                else { el._shown = target; animating = false; }\n            })(performance.now());\n        }).observe(el, { childList: true, characterData: true, subtree: true });\n    }\n})();\n"
          },
